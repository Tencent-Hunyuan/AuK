# Copy this file to .env and fill in your own credentials:
#   cp .env.example .env
#
# Choose one OpenAI-compatible text LLM provider.

# Tencent TokenHub HY3
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_MODEL_NAME=hy3

# DeepSeek V4 Flash (alternative)
# LLM_API_KEY=your-deepseek-api-key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL_NAME=deepseek-v4-flash

# Optional cloud ASR. Without these credentials (or if the cloud request fails),
# AuK lazily downloads and uses SenseVoiceSmall on CPU.
TENCENTCLOUD_SECRET_ID=your-tencentcloud-secret-id
TENCENTCLOUD_SECRET_KEY=your-tencentcloud-secret-key
ASR_ENGINE_MODEL_TYPE=16k_zh_en
